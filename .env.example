# ─── Connect atVentures 2026 · variables de entorno ───
# Copiar a .env.local (Next.js) o .env y completar. NUNCA commitear el archivo real.
# Ver APIS.md para detalles y fuentes.

# ── bem (https://docs.bem.ai) · header x-api-key · self-serve en https://app.bem.ai/auth/sign-up
BEM_API_KEY=                      # usar una key del entorno *sandbox*
BEM_BASE_URL=https://api.bem.ai
BEM_WORKFLOW_NAME=receta-workflow # nombre del workflow que crees mañana
BEM_WEBHOOK_SECRET=               # de POST /v3/webhook-secret (opcional)

# ── Taxo Facturación (https://docs.taxo.ws/facturacion) · headers X-Key / X-Password · key la entrega Taxo
TAXO_API_KEY=                     # X-Key
TAXO_CERT_PASSWORD=               # X-Password = clave del certificado de firma (solo para emitir)
TAXO_INVOICE_BASE_URL=https://invoice.taxo.ws
TAXO_AMBIENTE=1                   # 1 = pruebas SRI, 2 = producción. ¡Dejar en 1!
TAXO_SECUENCIAL_START=1000        # secuencial inicial no usado
TAXO_EMISOR_RUC=
TAXO_EMISOR_RAZON_SOCIAL=
TAXO_EMISOR_NOMBRE_COMERCIAL=
TAXO_EMISOR_DIRECCION=
TAXO_EMISOR_OBLIGADO_CONTABILIDAD=true
TAXO_EMISOR_ESTABLECIMIENTO=001
TAXO_EMISOR_PUNTO_EMISION=001

# ── Taxo Extracción (opcional: consulta de RUC) · header x-api-key · key tipo staging_...
TAXO_EXTRACTION_API_KEY=
TAXO_EXTRACTION_BASE_URL=https://staging-api.taxo.ws

# ── Mercately (https://mercately.redocly.app/apis) · header api-key · la genera un Admin en Configuración → API Key
MERCATELY_API_KEY=
MERCATELY_BASE_URL=https://app.mercately.com      # /retailers/api/v1/*
MERCATELY_SHOP_BASE_URL=https://mercately.shop    # /api/v1/orders, /api/v1/products
MERCATELY_TEMPLATE_ID=            # internal_id de plantilla aprobada (si es WhatsApp API oficial)
MERCATELY_WEBHOOK_TOKEN=          # valor del header propio que configures en el webhook de Mercately
DEMO_PHONE=+593999999999          # tu número para la demo

# ── LLM para Generative UI (uno de los dos)
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
GENUI_MODEL=                      # p.ej. gpt-5-mini (OpenAI) u openai/gpt-5-mini (AI Gateway) — confirmar disponibilidad

# ── App
PUBLIC_BASE_URL=http://localhost:3000   # URL pública (Vercel o túnel cloudflared) para links y webhooks
